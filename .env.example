# ─── PostgreSQL (Railway) ──────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# ─── NextAuth ──────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─── Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="cuidado-mayor-files"
# Endpoint S3-compatible de R2
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# Dominio público opcional (solo si exponés algún bucket público; por defecto usamos signed URLs)
R2_PUBLIC_BASE_URL=""

# ─── Resend (email transaccional) ──────────────────────────────
RESEND_API_KEY=""
# Remitente. Se acepta EMAIL_FROM o RESEND_FROM (alias).
EMAIL_FROM="Cuidado Mayor <noreply@cuidadomayor.app>"
RESEND_FROM="Cuidado Mayor <noreply@cuidadomayor.app>"

# ─── Cron (para alertas y reportes diarios) ────────────────────
# Secret compartido entre Railway Cron y los endpoints /api/jobs/*.
# Generar con: openssl rand -base64 32
CRON_SECRET=""

# ─── App ───────────────────────────────────────────────────────
APP_NAME="Cuidado Mayor"
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"
